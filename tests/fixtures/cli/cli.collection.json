{
  "info": {
    "name": "CLI fixture",
    "schema": "https://schema.getupstream.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
  "variable": [
    { "key": "host", "value": "coll.test" },
    { "key": "token", "value": "COLLTOKEN" }
  ],
  "item": [
    {
      "name": "ping",
      "event": [ { "listen": "test", "script": { "exec": [ "pm.test('x', function () {});" ] } } ],
      "request": { "method": "GET", "url": "https://{{host}}/status/200" }
    },
    {
      "name": "Payments",
      "item": [
        { "name": "send", "request": { "method": "POST", "url": "https://{{host}}/status/201",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"amount\": {{amount}}}" } } },
        { "name": "dup", "request": { "method": "GET", "url": "https://{{host}}/status/404" } }
      ]
    },
    {
      "name": "Refunds",
      "item": [
        { "name": "dup", "request": { "method": "GET", "url": "https://{{host}}/status/500" } }
      ]
    }
  ]
}
